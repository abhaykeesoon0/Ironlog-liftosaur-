# Gradle
.gradle/
build/
**/build/
.kotlin/

# Machine-specific SDK path -- never commit
local.properties

# Android Studio / IntelliJ: ignore everything except shared code style
.idea/*
!.idea/codeStyles/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Build outputs and signing
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore
# The release signing key and its passwords. Losing the key means no
# installed copy can ever be updated, so back it up somewhere private;
# committing it would hand the key to anyone with the repository.
keystore/
keystore.properties

# Logs and OS clutter
*.log
.DS_Store
Thumbs.db
desktop.ini

# Note: app/schemas/ is deliberately tracked -- Room needs the exported schema
# history to write and test migrations.
