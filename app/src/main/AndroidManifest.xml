<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         DEVICE INTEGRATION 1 - CAMERA (progress photos, avatar)
         ============================================================ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Logging a set by voice. The phone's recogniser does the listening; this app keeps only the words. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional: the scanner and the photos need it, logging a workout does not. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- ============================================================
         DEVICE INTEGRATION 2 - GPS / LOCATION (cardio route tracking)
         ============================================================ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ============================================================
         DEVICE INTEGRATION 3 - SENSORS (rep counting, step counting)
         ============================================================ -->
    <uses-permission
        android:name="android.permission.ACTIVITY_RECOGNITION"
        android:minSdkVersion="29" />

    <!-- A Bluetooth heart-rate strap during cardio. Scanning is declared as
         not for location, so no location grant is implied by it on 12+. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- ============================================================
         DEVICE INTEGRATION 4 - NOTIFICATIONS (rest timer, reminders)
         ============================================================ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Used by one optional feature only: the cloud assistant, which is off
        until the user turns it on and supplies their own API key. Everything
        else in the app works with no network at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The map asks whether the phone is online before requesting tiles, so it can show a blank grid quietly instead of erroring. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Steps written by a smartwatch's own app. Health Connect is on-device:
        this is an IPC read from another app on the same phone, not a network
        call, so the offline design holds.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Writing sessions and meals back, so the log shows in the user's health dashboard. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" />

    <!-- ============================================================
         DEVICE INTEGRATION 5 - FILE STORAGE (photo + CSV/JSON export)
         ============================================================
         No storage permission is declared. Photos and exports live in the
         app's private storage and leave through a FileProvider grant, and a
         gallery image is chosen with the system photo picker, which hands
         over one file without any read permission. -->

    <!-- Foreground services -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The coach model download runs as WorkManager foreground work, so a
         file of several hundred megabytes survives the user leaving the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Biometric app lock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Hardware is used where present but is not required to install -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:name=".IronLogApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IronLog"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IronLog.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A backup or a Strong/Hevy export shared from another app, or
                 opened from a file manager, lands on the settings screen. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Keeps GPS sampling alive while an outdoor cardio session records -->
        <service
            android:name=".core.location.CardioTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Keeps the rest countdown accurate when the screen is off -->
        <service
            android:name=".core.notifications.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counts down the rest interval between sets while the user is mid-workout." />
        </service>

        <!-- Quick Settings tile: the rest timer one swipe away, without opening the app. -->
        <service
            android:name=".core.notifications.RestTimerTile"
            android:exported="true"
            android:icon="@drawable/ic_splash_mark"
            android:label="Rest timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".core.notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- WorkManager's own foreground service, told which kind of work it may carry. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Scoped sharing of captured photos and exported data files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home-screen widget: this week, the streak, today's food. -->
        <receiver
            android:name=".core.widget.IronLogWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ironlog_widget_info" />
        </receiver>
    </application>

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
